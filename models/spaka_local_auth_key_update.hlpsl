% ==========================================================
% SPAKA local authentication and dynamic key-update model
%
% Roles:
%   V     - enrolled vehicle
%   ATAj  - home ATA
%
% Abstractions:
%   puf(PUFSeed, C) represents the symbolic SRAM-PUF response;
%   at ATAj it denotes the expected response retrieved from MS[C],
%   not a physical PUF call.
%   xor(N, R)       is the native HLPSL XOR operator
%   h(...)          represents the one-way hash function
%
% IMPLEMENTATION REPAIR: preserves the manuscript authenticator formulas:
%   Auths = H(Ms.Ri.T1), Authd = H(Md.Ri_next.T2).
% Native XOR receive patterns bind the peer nonce using the known PUF
% response. Primed variables denote values bound in the current transition.
% No direction tag or extra T0/Ns/Ci authenticator context is added.
% Only V and ATAj know PUFSeed. T (t_commit) is public timestamp state.
% The update uses the session key derived by this local-authentication run.
% Timestamps are symbolic values; numerical time-window/ordering checks,
% persistence across subsequent updates, and PUF reliability are not modeled.
% AUTHOR-CONFIRMED CACHE RULE (2026-11-06): ATA immediately records each
% issued challenge and rejects M3 challenges already used, including Ci.
% This model has exactly one session and an initially empty used cache.
% Before its sole M3 receive, Used = {Ci}; the stored Ci plus Ci_next /= Ci
% therefore represents this cache check exactly within this bounded scope.
% No claim is made for nonempty prior caches or shared concurrent sessions.
% Authenticator formulas, key derivations, events, and all six goals remain
% unchanged. Matching backend evidence is in verification_manifest.json.
% ==========================================================

role local_v(
             V, ATAj : agent,
             H       : hash_func,
             PUF     : hash_func,
             PUFSeed : text,
             T       : text,
             IDV     : message,
             SND, RCV : channel(dy))
played_by V def=

  local State : nat,
        T0, T1, T2, Tnew, Tack : text,
        Ci, Ci_next,
        Ns_prime, Nd_prime,
        Ri_prime, Ri_next,
        Cnew, Rnew,
        Ms, Md,
        SK_local, SK_new,
        Hup : message

  init State := 0

  transition

    % M1: V -> ATAj : { IDV, req, t0 }
    1. State = 0 /\ RCV(start) =|>
       State' := 1 /\
       T0' := new() /\
       SND(IDV.req.T0')

    % M2: ATAj -> V : { Ci, Ms, Auths, t1 }
    % Match native XOR using the known response: Ns = received Ms xor Ri.
    2. State = 1 /\
       RCV(Ci'.xor(Ns_prime', PUF(PUFSeed, Ci')).H(xor(Ns_prime', PUF(PUFSeed, Ci')).PUF(PUFSeed, Ci').T1').T1') =|>
       State' := 2 /\
       Ri_prime' := PUF(PUFSeed, Ci') /\
       Nd_prime' := new() /\
       Ci_next' := new() /\
       T2' := new() /\
       Ri_next' := PUF(PUFSeed, Ci_next') /\
       Ms' := xor(Ns_prime', Ri_prime') /\
       Md' := xor(Nd_prime', Ri_next') /\
       SK_local' := H(Ns_prime'.Nd_prime'.Ri_prime'.Ri_next'.T2') /\
       SND(Ci_next'.Md'.H(Md'.Ri_next'.T2').T2') /\
       witness(V, ATAj, local_vehicle_auth, Ci_next'.T2') /\
       request(V, ATAj, local_ataj_auth, Ci'.T1') /\
       secret(SK_local', sec_local_key, {V, ATAj})

    % M3 is V -> ATAj; ATAj checks Authd in its receive transition.
    % After sending M3, the vehicle starts key update.
    3. State = 2 =|>
       State' := 3 /\
       Cnew' := new() /\
       Tnew' := new() /\
       Rnew' := PUF(PUFSeed, Cnew') /\
       SK_new' := H(SK_local.Rnew'.T.Tnew') /\
       Hup' := H(SK_local.IDV.Cnew'.Rnew'.T.Tnew') /\
       SND(IDV.Tnew'.Cnew'.Hup') /\
       witness(V, ATAj, local_key_update_request, IDV.Cnew'.Tnew')

    % Key-update acknowledgement: ATAj -> V : { tack, Hack }
    4. State = 3 /\
       RCV(Tack'.H(SK_new.IDV.T.Tnew.Tack'.ack)) =|>
       State' := 4 /\
       request(V, ATAj, local_key_update_ack, Tack'.Tnew) /\
       secret(SK_new, sec_updated_key, {V, ATAj})

end role


role local_ataj(
                V, ATAj : agent,
                H       : hash_func,
                PUF     : hash_func,
                PUFSeed : text,
                T       : text,
                IDV     : message,
                SND, RCV : channel(dy))
played_by ATAj def=

  local State : nat,
        T0, T1, T2, Tnew, Tack : text,
        Ci, Ci_next,
        Ns, Nd_prime,
        Ri_next, Cnew, Rnew_prime,
        Ms, Md,
        SK_local, SK_new,
        Hup, Hack : message

  init State := 0

  transition

    % M1
    1. State = 0 /\
       RCV(IDV.req.T0') =|>
       State' := 1 /\
       T1' := new() /\
       Ci' := new() /\
       Ns' := new() /\
       Ms' := xor(Ns', PUF(PUFSeed, Ci')) /\
       SND(Ci'.Ms'.H(Ms'.PUF(PUFSeed, Ci').T1').T1') /\
       witness(ATAj, V, local_ataj_auth, Ci'.T1')

    % M3: reject the already issued challenge (Used = {Ci} in this model).
    % Ci retains the value recorded atomically when M2 is sent at State 0 -> 1.
    2. State = 1 /\
       RCV(Ci_next'.xor(Nd_prime', PUF(PUFSeed, Ci_next')).H(xor(Nd_prime', PUF(PUFSeed, Ci_next')).PUF(PUFSeed, Ci_next').T2').T2') /\
       Ci_next' /= Ci =|>
       State' := 2 /\
       Ri_next' := PUF(PUFSeed, Ci_next') /\
       Md' := xor(Nd_prime', Ri_next') /\
       SK_local' := H(Ns.Nd_prime'.PUF(PUFSeed, Ci).Ri_next'.T2') /\
       request(ATAj, V, local_vehicle_auth, Ci_next'.T2') /\
       secret(SK_local', sec_local_key, {V, ATAj})

    % Key-update request and acknowledgement
    3. State = 2 /\
       RCV(IDV.Tnew'.Cnew'.H(SK_local.IDV.Cnew'.PUF(PUFSeed, Cnew').T.Tnew')) =|>
       State' := 3 /\
       Rnew_prime' := PUF(PUFSeed, Cnew') /\
       SK_new' := H(SK_local.Rnew_prime'.T.Tnew') /\
       Tack' := new() /\
       Hack' := H(SK_new'.IDV.T.Tnew'.Tack'.ack) /\
       request(ATAj, V, local_key_update_request, IDV.Cnew'.Tnew') /\
       witness(ATAj, V, local_key_update_ack, Tack'.Tnew') /\
       SND(Tack'.Hack') /\
       secret(SK_new', sec_updated_key, {V, ATAj})

end role


role local_session(
                   V, ATAj : agent,
                   H       : hash_func,
                   PUF     : hash_func,
                   PUFSeed : text,
                   T       : text,
                   IDV     : message) def=

  local SNDV, RCVV,
        SNDA, RCVA : channel(dy)

  composition
    local_v(V, ATAj, H, PUF, PUFSeed, T, IDV, SNDV, RCVV)
    /\ local_ataj(V, ATAj, H, PUF, PUFSeed, T, IDV, SNDA, RCVA)

end role


role environment() def=

  const v, ataj, intruder : agent,
        h, puf : hash_func,
        pufseed : text,
        t_commit : text,
        idv : message,
        req, ack : message,
        sec_local_key,
        sec_updated_key,
        local_ataj_auth,
        local_vehicle_auth,
        local_key_update_request,
        local_key_update_ack : protocol_id

  intruder_knowledge = {intruder, v, ataj, h, puf, idv, req, ack, t_commit}

  composition
    local_session(v, ataj, h, puf, pufseed, t_commit, idv)

end role

goal
  secrecy_of sec_local_key
  secrecy_of sec_updated_key
  authentication_on local_ataj_auth
  authentication_on local_vehicle_auth
  authentication_on local_key_update_request
  authentication_on local_key_update_ack
end goal

environment()
